# Copy to .env and fill in to enable the live Claude-powered coach.
# Without it, the app still works fully — the coach uses its offline rule engine.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the backend port (must match the Vite proxy target).
# PORT=8787

# Optional hardening (sensible defaults if unset):
# ALLOWED_ORIGIN=http://localhost:5173   # CORS origin allowed to call the API
# COACH_API_TOKEN=                        # if set, requests must send: Authorization: Bearer <token>
